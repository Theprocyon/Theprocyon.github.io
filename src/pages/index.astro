---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { Content as HomeContent } from "../data/home.md";
import { HOME } from "@consts";
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION} lang="en">
  <Container>
    <article class="home-content animate">
      <HomeContent />
    </article>
  </Container>
</PageLayout>

<style>
  .home-content :global(p) {
    @apply font-sans;
  }

  .home-content :global(h1) {
    @apply mb-2 mt-0 text-3xl;
  }

  .home-content :global(h1 + p) {
    @apply mt-0;
  }

  .home-content :global(h2) {
    @apply mb-3 mt-10 text-lg;
  }

  .home-content :global(h3) {
    @apply mb-0 mt-3 text-base;
  }

  .home-content :global(h3 + p) {
    @apply mt-1;
  }
</style>
